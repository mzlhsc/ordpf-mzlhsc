.mine-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #2f2925, #4a392e);
  color: #fff7f0;
  box-shadow: 0 18rpx 38rpx rgba(47, 41, 37, 0.2);
}

.profile-orb {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  right: -70rpx;
  top: -80rpx;
  border-radius: 50%;
  background: rgba(255, 220, 194, 0.08);
}

.profile-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.avatar-lg {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #ff6b35;
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 20rpx rgba(255, 107, 53, 0.24);
}

.profile-info {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 800;
}

.profile-id {
  margin-top: 4rpx;
  color: rgba(255, 235, 220, 0.58);
  font-size: 21rpx;
}

.login-btn {
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 23rpx;
  line-height: 60rpx;
}

.profile-foot {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 228, 210, 0.12);
}

.foot-item {
  flex: 1;
  text-align: center;
}

.foot-num {
  font-size: 34rpx;
  font-weight: 700;
}

.foot-unit {
  margin-left: 2rpx;
  font-size: 19rpx;
  font-weight: 400;
  color: rgba(255, 235, 220, 0.6);
}

.foot-label {
  margin-top: 4rpx;
  color: rgba(255, 235, 220, 0.52);
  font-size: 19rpx;
}

.foot-line {
  width: 1rpx;
  height: 46rpx;
  background: rgba(255, 228, 210, 0.12);
}

.service-card,
.menu-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(75, 47, 31, 0.055);
}

.service-title {
  font-size: 27rpx;
  font-weight: 700;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 6rpx 14rpx;
  border-radius: 16rpx;
  background: #faf7f3;
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #fff0e6;
  color: #e95828;
  font-size: 28rpx;
}

.service-text {
  margin-top: 10rpx;
  color: #615a53;
  font-size: 21rpx;
}

.menu-card {
  padding: 4rpx 24rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f5f1ed;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #4e4842;
  font-size: 26rpx;
}

.menu-icon {
  color: #e95828;
  font-size: 26rpx;
  width: 34rpx;
}

.menu-arrow {
  color: #bbb3ac;
  font-size: 32rpx;
}

.menu-value {
  color: #9e958d;
  font-size: 20rpx;
  max-width: 60%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.about-card {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #fffaf6;
  border: 1rpx solid #f6e9df;
  text-align: center;
}

.about-brand {
  color: #70462f;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.about-desc {
  margin-top: 6rpx;
  color: #ab9181;
  font-size: 21rpx;
}

.logout-btn {
  height: 84rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #eee7e1;
  background: #fff;
  color: #8a8179;
  font-size: 25rpx;
  line-height: 82rpx;
}

.version {
  margin-top: 30rpx;
  color: #bbb3ac;
  font-size: 19rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
