<view class="edit-page">
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请填写收货人姓名" placeholder-class="ph" value="{{form.consignee}}" data-field="consignee" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">性别</text>
      <view class="sex-group">
        <view class="sex-item {{form.sex === '1' ? 'active' : ''}}" data-sex="1" bindtap="setSex">先生</view>
        <view class="sex-item {{form.sex === '2' ? 'active' : ''}}" data-sex="2" bindtap="setSex">女士</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请填写手机号" placeholder-class="ph" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">所在地区</text>
      <picker class="form-input picker-value" mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="{{regionText ? 'region-text' : 'ph'}}">{{regionText || '省 / 市 / 区'}}</view>
      </picker>
    </view>
    <view class="form-row detail-row">
      <text class="form-label">详细地址</text>
      <textarea class="detail-input" placeholder="街道、门牌号、楼层、房间号" placeholder-class="ph" maxlength="120" value="{{form.detail}}" data-field="detail" bindinput="onInput"></textarea>
    </view>
    <view class="form-row">
      <text class="form-label">地址标签</text>
      <view class="label-group">
        <view wx:for="{{labels}}" wx:key="*this" class="label-item {{form.label === item ? 'active' : ''}}" data-label="{{item}}" bindtap="setLabel">{{item}}</view>
      </view>
    </view>
    <view class="form-row last">
      <text class="form-label">设为默认</text>
      <switch checked="{{form.isDefault}}" color="#ff6b35" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="save-bar">
    <button class="btn-primary {{saving ? 'is-disabled' : ''}}" bindtap="save" disabled="{{saving}}">
      {{saving ? '保存中…' : '保存地址'}}
    </button>
  </view>
</view>
