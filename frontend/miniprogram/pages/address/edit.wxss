.edit-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
}

.form-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(75, 47, 31, 0.055);
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  margin: 0 24rpx;
  border-bottom: 1rpx solid #f3eee9;
}

.form-row.last {
  border-bottom: none;
}

.detail-row {
  align-items: flex-start;
  padding: 24rpx 0;
}

.form-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #5e574f;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  font-size: 26rpx;
  color: #2f2b27;
  text-align: right;
}

.detail-input {
  flex: 1;
  min-width: 0;
  height: 130rpx;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: right;
}

.ph {
  color: #b3aba4;
  font-size: 25rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.region-text {
  color: #2f2b27;
  font-size: 26rpx;
}

.sex-group,
.label-group {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.sex-item,
.label-item {
  min-width: 86rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid #f0e9e3;
  border-radius: 999rpx;
  color: #7c746d;
  font-size: 23rpx;
  line-height: 54rpx;
  text-align: center;
}

.sex-item.active,
.label-item.active {
  border-color: #ffc6ae;
  background: #fff1e9;
  color: #e95828;
  font-weight: 600;
}

.save-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
}
