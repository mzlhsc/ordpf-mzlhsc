<view class="checkout-page">
  <view class="address-card" bindtap="chooseAddress">
    <view class="address-icon">⌂</view>
    <view class="address-main" wx:if="{{address}}">
      <view class="address-line">
        <text class="consignee">{{address.consignee}}</text>
        <text class="phone">{{address.phone}}</text>
        <text class="default-tag" wx:if="{{address.isDefault}}">默认</text>
      </view>
      <view class="address-detail">{{addressText}}</view>
    </view>
    <view class="address-main" wx:else>
      <view class="address-empty">请选择收货地址</view>
      <view class="address-hint">配送前请填写联系人和详细地址</view>
    </view>
    <view class="chevron">›</view>
  </view>

  <view class="card order-card">
    <view class="card-title">
      <text>订单商品</text>
      <text class="muted small">共 {{totalCount}} 件</text>
    </view>
    <view class="order-item" wx:for="{{items}}" wx:key="id">
      <view class="order-pic">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
        <view wx:else class="pic-fallback">味</view>
      </view>
      <view class="order-info">
        <view class="order-name">{{item.name}}</view>
        <view class="order-flavor" wx:if="{{item.dishFlavor}}">{{item.dishFlavor}}</view>
      </view>
      <view class="order-right">
        <view class="order-price">¥{{item.lineTotal}}</view>
        <view class="order-num">×{{item.number}}</view>
      </view>
    </view>
  </view>

  <view class="card pay-card">
    <view class="row">
      <view>
        <view class="row-title">支付方式</view>
        <view class="row-sub">演示环境：提交订单即视为已支付</view>
      </view>
      <view class="pay-method"><text class="pay-dot"></text> 在线支付</view>
    </view>
    <view class="divider"></view>
    <view class="row">
      <view class="row-title">餐具数量</view>
      <view class="tableware">
        <button class="tiny-btn" bindtap="minusTableware">−</button>
        <text class="tableware-num">{{tablewareNumber}}</text>
        <button class="tiny-btn" bindtap="plusTableware">＋</button>
      </view>
    </view>
    <view class="divider"></view>
    <view class="remark-wrap">
      <view class="row-title">订单备注</view>
      <textarea
        class="remark-input"
        placeholder="口味、忌口、送达要求等"
        placeholder-class="remark-placeholder"
        maxlength="100"
        value="{{remark}}"
        bindinput="onRemark"
      ></textarea>
    </view>
  </view>

  <view class="card summary-card">
    <view class="summary-row">
      <text>商品金额</text>
      <text>¥{{goodsAmountText}}</text>
    </view>
    <view class="summary-row">
      <text>打包费</text>
      <text>¥0.00</text>
    </view>
    <view class="summary-row total-row">
      <text>合计</text>
      <text class="total-price"><text class="price-symbol">¥</text>{{totalAmountText}}</text>
    </view>
  </view>

  <view class="submit-bar">
    <view class="submit-total">
      <view class="submit-label">应付</view>
      <view class="submit-price"><text class="price-symbol">¥</text>{{totalAmountText}}</view>
    </view>
    <button class="submit-btn {{submitting ? 'loading' : ''}}" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '提交订单'}}
    </button>
  </view>
</view>
