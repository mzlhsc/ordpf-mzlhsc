.checkout-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(210rpx + env(safe-area-inset-bottom));
}

.address-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(75, 47, 31, 0.08);
}

.address-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff0e6;
  color: #ed5a24;
  font-size: 34rpx;
  flex-shrink: 0;
}

.address-main {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx 0 18rpx;
}

.address-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.consignee {
  font-size: 30rpx;
  font-weight: 700;
}

.phone {
  color: #79716a;
  font-size: 24rpx;
}

.default-tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #fff0e6;
  color: #ed5a24;
  font-size: 19rpx;
}

.address-detail {
  margin-top: 8rpx;
  color: #77706a;
  font-size: 24rpx;
  line-height: 1.45;
}

.address-empty {
  font-size: 29rpx;
  font-weight: 600;
}

.address-hint {
  margin-top: 6rpx;
  color: #a49c95;
  font-size: 22rpx;
}

.chevron {
  color: #bbb3ac;
  font-size: 36rpx;
  line-height: 1;
}

.card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.order-pic {
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #ffe8d6, #ffd2b5);
  flex-shrink: 0;
}

.order-pic image {
  width: 100%;
  height: 100%;
}

.pic-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #e28a5b;
  font-size: 30rpx;
  font-weight: 700;
}

.order-info {
  flex: 1;
  min-width: 0;
  padding-left: 16rpx;
}

.order-name {
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.order-flavor {
  margin-top: 4rpx;
  color: #a49d96;
  font-size: 21rpx;
}

.order-right {
  text-align: right;
  margin-left: 10rpx;
}

.order-price {
  font-size: 26rpx;
  font-weight: 600;
}

.order-num {
  margin-top: 4rpx;
  color: #a49d96;
  font-size: 21rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}

.row-title {
  font-size: 27rpx;
  font-weight: 600;
}

.row-sub {
  margin-top: 4rpx;
  color: #a49d96;
  font-size: 21rpx;
}

.pay-method {
  display: flex;
  align-items: center;
  color: #ed5a24;
  font-size: 24rpx;
}

.pay-dot {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border: 3rpx solid #ff6b35;
  border-radius: 50%;
  background: #fff4ee;
}

.tableware {
  display: flex;
  align-items: center;
  height: 54rpx;
  border: 1rpx solid #f0eae4;
  border-radius: 999rpx;
  overflow: hidden;
}

.tiny-btn {
  width: 52rpx;
  height: 52rpx;
  font-size: 28rpx;
  line-height: 50rpx;
  text-align: center;
  color: #6f665e;
}

.tiny-btn:last-child {
  background: #fff2ea;
  color: #ed5a24;
}

.tableware-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 24rpx;
}

.remark-wrap {
  padding-top: 18rpx;
}

.remark-input {
  width: 100%;
  height: 120rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #faf8f5;
  font-size: 24rpx;
  line-height: 1.5;
}

.remark-placeholder {
  color: #b7afa7;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  color: #756d66;
  font-size: 25rpx;
}

.total-row {
  margin-top: 6rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2ede8;
  color: #2b2b2b;
  font-size: 28rpx;
  font-weight: 600;
}

.total-price {
  color: #ff5a1f;
  font-size: 34rpx;
  font-weight: 800;
}

.submit-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 16rpx 0 28rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 16rpx 36rpx rgba(75, 47, 31, 0.14);
}

.submit-total {
  flex: 1;
}

.submit-label {
  font-size: 21rpx;
  color: #9a938c;
}

.submit-price {
  color: #ff5a1f;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
}

.submit-price .price-symbol {
  font-size: 23rpx;
}

.submit-btn {
  height: 82rpx;
  padding: 0 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8b55, #ff5a1f);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 82rpx;
  box-shadow: 0 10rpx 20rpx rgba(255, 90, 31, 0.22);
}

.submit-btn.loading {
  background: #d8d2cc;
  box-shadow: none;
}
