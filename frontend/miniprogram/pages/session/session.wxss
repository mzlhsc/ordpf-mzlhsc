.session-page {
  min-height: 100vh;
  padding: 20rpx 28rpx 0;
}

.table-hero {
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #2f2925, #463830);
  color: #fff7ef;
  box-shadow: 0 18rpx 38rpx rgba(47, 41, 37, 0.2);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-label {
  color: rgba(255, 226, 203, 0.52);
  font-size: 19rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-status {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #ffe1cf;
  font-size: 21rpx;
}

.hero-status.status-2 {
  background: rgba(255, 190, 112, 0.2);
  color: #ffd18d;
}

.hero-status.status-3 {
  background: rgba(122, 213, 145, 0.18);
  color: #b4e3c3;
}

.hero-status.status-4 {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.55);
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  color: rgba(255, 235, 220, 0.64);
  font-size: 21rpx;
}

.dot {
  opacity: 0.45;
}

.hero-no {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  color: rgba(255, 235, 220, 0.5);
  font-size: 20rpx;
}

.copy {
  padding: 2rpx 12rpx;
  border: 1rpx solid rgba(255, 220, 193, 0.3);
  border-radius: 999rpx;
  color: #ffddc7;
}

.bill-card {
  display: flex;
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(75, 47, 31, 0.07);
}

.bill-main {
  flex: 1;
  min-width: 0;
}

.bill-label {
  color: #9d948c;
  font-size: 22rpx;
}

.bill-amount {
  margin-top: 4rpx;
  color: #ff5a1f;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.bill-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.bill-hint {
  margin-top: 6rpx;
  color: #aaa29b;
  font-size: 20rpx;
}

.bill-stats {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  min-width: 180rpx;
  padding-left: 22rpx;
  border-left: 1rpx solid #f2ede8;
}

.bill-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stat-label {
  color: #9a928a;
  font-size: 21rpx;
}

.stat-value {
  color: #4d4640;
  font-size: 24rpx;
  font-weight: 600;
}

.card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 16rpx;
}

.card-title {
  font-size: 29rpx;
  font-weight: 700;
}

.card-sub {
  margin-top: 3rpx;
  color: #a29a93;
  font-size: 21rpx;
}

.head-actions {
  display: flex;
  gap: 10rpx;
}

.head-btn {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff2ea;
  color: #e95828;
  font-size: 22rpx;
  line-height: 52rpx;
}

.head-btn.muted {
  background: #f6f3f0;
  color: #958c84;
}

.member-scroll {
  white-space: nowrap;
  padding-top: 4rpx;
}

.member {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 116rpx;
  margin-right: 8rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #fff0e6;
  color: #e95828;
  font-size: 28rpx;
  font-weight: 700;
}

.avatar.owner {
  background: #2f2925;
  color: #ffe4d3;
}

.member-name {
  width: 110rpx;
  margin-top: 8rpx;
  color: #625a53;
  font-size: 21rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-role {
  margin-top: 2rpx;
  color: #aaa29b;
  font-size: 18rpx;
}

.aa-tip {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #fff6ef;
  color: #b06a43;
  font-size: 22rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f5f1ed;
}

.cart-pic {
  width: 92rpx;
  height: 92rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #ffe8d6, #ffd2b5);
  flex-shrink: 0;
}

.cart-pic image {
  width: 100%;
  height: 100%;
}

.pic-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #e28a5b;
  font-size: 30rpx;
  font-weight: 700;
}

.cart-main {
  flex: 1;
  min-width: 0;
  padding-left: 16rpx;
}

.cart-name {
  font-size: 27rpx;
  font-weight: 600;
}

.cart-flavor {
  margin-top: 3rpx;
  color: #a29a93;
  font-size: 20rpx;
}

.cart-unit {
  margin-top: 4rpx;
  color: #9c938b;
  font-size: 20rpx;
}

.cart-side {
  text-align: right;
}

.cart-line {
  color: #ff5a1f;
  font-size: 25rpx;
  font-weight: 700;
}

.stepper {
  display: flex;
  align-items: center;
  height: 48rpx;
  margin-top: 8rpx;
  border: 1rpx solid #f0eae4;
  border-radius: 999rpx;
  overflow: hidden;
}

.step-btn {
  width: 48rpx;
  height: 46rpx;
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: center;
  color: #6f665e;
}

.step-btn.plus {
  background: #fff2ea;
  color: #ed5a24;
  font-weight: 700;
}

.step-num {
  min-width: 42rpx;
  text-align: center;
  font-size: 22rpx;
}

.cart-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
}

.cart-empty-text {
  color: #a39b93;
  font-size: 22rpx;
}

.cart-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  color: #8e867e;
  font-size: 23rpx;
}

.cart-total {
  color: #ff5a1f;
  font-size: 32rpx;
  font-weight: 800;
}

.order-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f1ed;
}

.order-left {
  min-width: 0;
}

.order-no {
  font-size: 25rpx;
  font-weight: 600;
}

.order-time {
  margin-top: 3rpx;
  color: #a29a93;
  font-size: 20rpx;
}

.order-right {
  text-align: right;
}

.order-status {
  color: #e95828;
  font-size: 20rpx;
}

.order-amount {
  margin-top: 3rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.order-empty {
  padding: 18rpx 0 4rpx;
  color: #a39b93;
  font-size: 22rpx;
}

.bottom-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.action-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 16rpx 36rpx rgba(75, 47, 31, 0.14);
}

.action-ghost {
  height: 72rpx;
  padding: 0 26rpx;
  border: 1rpx solid #eee7e1;
  border-radius: 999rpx;
  color: #756d66;
  font-size: 23rpx;
  line-height: 70rpx;
}

.action-primary {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8b55, #ff5a1f);
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.join-page {
  padding: 120rpx 40rpx;
}

.join-card {
  padding: 50rpx 30rpx;
  border-radius: 28rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(75, 47, 31, 0.07);
}

.join-icon {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #fff0e6;
  color: #e95828;
  font-size: 46rpx;
  line-height: 100rpx;
}

.join-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.join-desc {
  margin-top: 8rpx;
  color: #a29a93;
  font-size: 23rpx;
}

.join-btn {
  margin-top: 34rpx;
}

.empty-btn {
  margin-top: 24rpx;
}
