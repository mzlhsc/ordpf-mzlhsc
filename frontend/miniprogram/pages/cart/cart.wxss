.cart-page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.cart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 6rpx 24rpx;
}

.cart-title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.cart-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9a938c;
}

.clear-btn {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8c8178;
  font-size: 23rpx;
  line-height: 56rpx;
  box-shadow: 0 4rpx 12rpx rgba(75, 47, 31, 0.05);
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cart-item {
  display: flex;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(75, 47, 31, 0.055);
}

.item-pic {
  flex: 0 0 148rpx;
  width: 148rpx;
  height: 148rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffe8d6, #ffd2b5);
}

.item-pic image {
  width: 100%;
  height: 100%;
}

.pic-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #e28a5b;
  font-size: 38rpx;
  font-weight: 700;
}

.item-main {
  flex: 1;
  min-width: 0;
  padding: 4rpx 14rpx 4rpx 18rpx;
}

.item-name {
  font-size: 29rpx;
  font-weight: 700;
}

.item-flavor {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #a79f97;
}

.item-price {
  margin-top: 18rpx;
  color: #7d746c;
  font-size: 25rpx;
}

.item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  padding: 4rpx 0;
}

.item-line-total {
  color: #ff5a1f;
  font-weight: 700;
  font-size: 27rpx;
}

.stepper {
  display: flex;
  align-items: center;
  height: 56rpx;
  border: 1rpx solid #f0eae4;
  border-radius: 999rpx;
  overflow: hidden;
}

.step-btn {
  width: 56rpx;
  height: 54rpx;
  font-size: 32rpx;
  line-height: 52rpx;
  text-align: center;
  color: #6f665e;
}

.step-btn.plus {
  background: #fff2ea;
  color: #ed5a24;
  font-weight: 700;
}

.step-num {
  min-width: 52rpx;
  text-align: center;
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.empty-btn {
  margin-top: 30rpx;
}

.checkout-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 16rpx 0 28rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 16rpx 36rpx rgba(75, 47, 31, 0.14);
}

.checkout-total {
  flex: 1;
}

.total-label {
  font-size: 21rpx;
  color: #9a938c;
}

.total-value {
  color: #ff5a1f;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
}

.total-value .price-symbol {
  font-size: 23rpx;
}

.checkout-btn {
  height: 82rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8b55, #ff5a1f);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 82rpx;
  box-shadow: 0 10rpx 20rpx rgba(255, 90, 31, 0.22);
}
