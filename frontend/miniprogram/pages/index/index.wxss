.home {
  padding: 24rpx 28rpx 190rpx;
}

/* ========== Hero ========== */
.hero {
  position: relative;
  overflow: hidden;
  min-height: 330rpx;
  padding: 28rpx 30rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(140deg, #ff8b55 0%, #ff6b35 46%, #ef4f18 100%);
  box-shadow: 0 20rpx 40rpx rgba(239, 79, 24, 0.22);
  color: #fff;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.orb-a {
  width: 240rpx;
  height: 240rpx;
  right: -70rpx;
  top: -90rpx;
}

.orb-b {
  width: 150rpx;
  height: 150rpx;
  right: 100rpx;
  bottom: -80rpx;
  background: rgba(255, 240, 220, 0.14);
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-line {
  display: flex;
  align-items: baseline;
}

.brand {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  font-family: Georgia, "Times New Roman", serif;
}

.brand-sub {
  margin-left: 8rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  opacity: 0.88;
}

.shop-state {
  display: flex;
  align-items: center;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  backdrop-filter: blur(4px);
}

.shop-state .dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #ffe58f;
}

.shop-state.off .dot {
  background: #c7c2bd;
}

.hero-title {
  position: relative;
  z-index: 2;
  margin-top: 34rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.18;
}

.hero-desc {
  position: relative;
  z-index: 2;
  margin-top: 12rpx;
  font-size: 25rpx;
  opacity: 0.92;
}

.hero-tags {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-tag {
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.92);
}

.hero-badge {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  z-index: 3;
  width: 132rpx;
  height: 132rpx;
  padding-top: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 250, 243, 0.96);
  color: #8b3c1f;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(117, 43, 12, 0.18);
  transform: rotate(3deg);
}

.hero-badge-num {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-badge-unit {
  margin-left: 2rpx;
  font-size: 19rpx;
}

.hero-badge-text {
  display: block;
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #ad7459;
}

/* ========== 提示 ========== */
.notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff3e8;
  color: #b7652d;
  font-size: 23rpx;
}

.notice-icon {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #ffb37b;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 30rpx;
}

/* ========== 分类 ========== */
.cats {
  margin-top: 28rpx;
  white-space: nowrap;
}

.cat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-right: 16rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #6f6862;
  font-size: 25rpx;
  box-shadow: 0 4rpx 16rpx rgba(92, 62, 42, 0.05);
}

.cat.active {
  background: #2d211b;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(45, 33, 27, 0.18);
}

/* ========== 套餐 ========== */
.setmeal-scroll {
  white-space: nowrap;
}

.setmeal-card {
  display: inline-block;
  width: 276rpx;
  margin-right: 18rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(75, 47, 31, 0.06);
  vertical-align: top;
}

.setmeal-pic {
  position: relative;
  height: 158rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ffe8d6, #ffd2b5);
}

.setmeal-pic image,
.dish-pic image {
  width: 100%;
  height: 100%;
}

.pic-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #e28a5b;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.setmeal-badge {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(45, 33, 27, 0.82);
  color: #ffe0cd;
  font-size: 19rpx;
}

.setmeal-name {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.setmeal-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a29a92;
}

.setmeal-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.setmeal-bottom .price {
  font-size: 30rpx;
}

.mini-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ff5a1f;
  color: #fff;
  font-size: 30rpx;
  line-height: 46rpx;
  text-align: center;
  font-weight: 700;
}

/* ========== 菜品 ========== */
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 34rpx 4rpx 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.section-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a19a93;
}

.dish-head {
  margin-top: 40rpx;
}

.fresh-tip {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #9a8f86;
}
.fresh-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #78b874;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.dish-card {
  display: flex;
  padding: 16rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(75, 47, 31, 0.055);
}

.dish-pic {
  position: relative;
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ffe8d6, #ffd2b5);
}

.sold-out {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(43, 33, 27, 0.54);
  color: #fff;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.dish-main {
  flex: 1;
  min-width: 0;
  padding: 4rpx 0 2rpx 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 700;
}

.dish-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a19a92;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dish-meta {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.dish-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}

.dish-bottom .price {
  font-size: 34rpx;
}

.add-btn {
  min-width: 64rpx;
  height: 60rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8b55, #ff5a1f);
  color: #fff;
  font-size: 38rpx;
  line-height: 58rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 8rpx 16rpx rgba(255, 90, 31, 0.25);
}

.add-btn.disabled {
  background: #e7e3df;
  color: #a29a92;
  font-size: 22rpx;
  box-shadow: none;
}

/* ========== 购物车悬浮条 ========== */
.cart-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 18rpx 0 20rpx;
  border-radius: 999rpx;
  background: #2d211b;
  color: #fff;
  box-shadow: 0 18rpx 40rpx rgba(45, 33, 27, 0.32);
}

.cart-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #ff6b35;
}

.cart-glyph {
  font-size: 38rpx;
  line-height: 1;
}

.cart-count {
  position: absolute;
  top: -6rpx;
  right: -4rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #fff3e8;
  color: #e95828;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.cart-info {
  flex: 1;
  padding-left: 18rpx;
}

.cart-total {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.cart-tip {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.58);
}

.cart-go {
  height: 76rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8b55, #ff5a1f);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.arrow {
  margin-left: 4rpx;
  font-size: 28rpx;
}
