.menu-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 180rpx;
}

.menu-header {
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(140deg, #2f2925, #4a3a30);
  color: #fff8f0;
  box-shadow: 0 16rpx 34rpx rgba(47, 41, 37, 0.16);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-eyebrow {
  color: rgba(255, 226, 203, 0.52);
  font-size: 19rpx;
  letter-spacing: 3rpx;
}

.header-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.header-desc {
  margin-top: 6rpx;
  color: rgba(255, 235, 220, 0.66);
  font-size: 22rpx;
}

.header-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 220, 193, 0.32);
}

.badge-num {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.1;
}

.badge-text {
  color: rgba(255, 235, 220, 0.62);
  font-size: 18rpx;
}

.cats {
  margin-top: 24rpx;
  white-space: nowrap;
}

.cat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #746c65;
  font-size: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(75, 47, 31, 0.05);
}

.cat.active {
  background: #ff6b35;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 53, 0.2);
}

.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 28rpx 4rpx 16rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 800;
}

.list-sub {
  color: #a19891;
  font-size: 21rpx;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-card {
  display: flex;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(75, 47, 31, 0.05);
}

.dish-pic {
  position: relative;
  flex: 0 0 160rpx;
  width: 160rpx;
  height: 160rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffe8d6, #ffd2b5);
}

.dish-pic image {
  width: 100%;
  height: 100%;
}

.pic-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #e28a5b;
  font-size: 40rpx;
  font-weight: 700;
}

.sold-out {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(43, 33, 27, 0.54);
  color: #fff;
  font-size: 24rpx;
}

.dish-main {
  flex: 1;
  min-width: 0;
  padding: 4rpx 0 0 18rpx;
}

.dish-name {
  font-size: 29rpx;
  font-weight: 700;
}

.dish-desc {
  margin-top: 4rpx;
  color: #a19891;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dish-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.dish-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 10rpx;
}

.dish-bottom .price {
  font-size: 32rpx;
}

.add-btn {
  min-width: 62rpx;
  height: 58rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8b55, #ff5a1f);
  color: #fff;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 8rpx 16rpx rgba(255, 90, 31, 0.2);
}

.add-btn.disabled {
  background: #e7e3df;
  color: #a29a92;
  font-size: 21rpx;
  box-shadow: none;
}

.cart-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 18rpx 0 30rpx;
  border-radius: 999rpx;
  background: #2d211b;
  color: #fff;
  box-shadow: 0 16rpx 36rpx rgba(45, 33, 27, 0.28);
}

.cart-left {
  flex: 1;
}

.cart-count {
  color: rgba(255, 255, 255, 0.65);
  font-size: 21rpx;
}

.cart-total {
  margin-top: 2rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.cart-go {
  height: 74rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #ff6b35;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 74rpx;
}
