<view class="menu-page">
  <view class="menu-header">
    <view class="header-top">
      <view>
        <view class="header-eyebrow">SHARED MENU · 同桌共享</view>
        <view class="header-title">{{tableName || '堂食点菜'}}</view>
        <view class="header-desc">加进同桌菜单，大家一起吃</view>
      </view>
      <view class="header-badge"><text class="badge-num">{{cartCount}}</text><text class="badge-text">已选</text></view>
    </view>
  </view>

  <scroll-view class="cats" scroll-x enable-flex show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat {{item.id === activeCategory ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectCategory"
    >{{item.name}}</view>
  </scroll-view>

  <view class="list-head">
    <text class="list-title">{{activeCategoryName}}</text>
    <text class="list-sub">{{dishes.length}} 道菜</text>
  </view>

  <view class="dish-list">
    <view class="dish-card" wx:for="{{dishes}}" wx:key="id">
      <view class="dish-pic">
        <image wx:if="{{item.image && !item.imageError}}" src="{{item.image}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>
        <view wx:else class="pic-fallback">味</view>
        <view class="sold-out" wx:if="{{item.soldOut}}">售罄</view>
      </view>
      <view class="dish-main">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-desc">{{item.description || '现点现做，新鲜上桌'}}</view>
        <view class="dish-tags">
          <text class="tag" wx:if="{{item.hasStock}}">余 {{item.stock}} 份</text>
          <text class="tag tag-gray" wx:if="{{item.flavors.length}}">{{item.flavors.length}} 种口味</text>
        </view>
        <view class="dish-bottom">
          <view class="price"><text class="price-symbol">¥</text>{{item.priceText}}</view>
          <button class="add-btn {{item.soldOut ? 'disabled' : ''}}" catchtap="addDish" data-index="{{index}}">
            {{item.soldOut ? '售罄' : '＋'}}
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="loading-line" wx:if="{{loading}}">正在加载菜单…</view>
  <view class="empty" wx:if="{{!loading && !dishes.length}}">
    <view class="empty-icon">🍽</view>
    <view class="empty-title">这个分类还没有菜</view>
  </view>

  <view class="cart-bar" wx:if="{{cartCount > 0}}" bindtap="goSession">
    <view class="cart-left">
      <view class="cart-count">{{cartCount}} 道</view>
      <view class="cart-total">¥{{cartAmountText}}</view>
    </view>
    <view class="cart-go">查看同桌菜单 <text>›</text></view>
  </view>
</view>


