<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mzlhsc</groupId>
        <artifactId>ordpf-mzlhsc</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>ordpf-common</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 令牌工具：JwtTool / JwtProperties / 自动配置。
             注意：绝不能依赖 ordpf-gateway，那会把 Gateway 的自动配置（WebFlux）
             带进所有 Servlet 服务，启动直接失败。 -->
        <dependency>
            <groupId>com.mzlhsc</groupId>
            <artifactId>ordpf-auth</artifactId>
        </dependency>
        <!-- hutool 工具包（CollUtils / StrUtil / PageQuery 等都用它） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- 完成SpringMVC自动装配 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 参数校验（@NotNull / @NotBlank），Boot 4 里 webmvc starter 不再自带 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 接口文档（PageQuery 等类用到了 swagger 注解） -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
        </dependency>

        <!-- fastjson v1 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>

        <!-- apache httpclient 4.x -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- 只需要密码学工具（BCryptPasswordEncoder、KeyStoreKeyFactory），
             用 spring-security-crypto 即可；引入 spring-boot-starter-security 会激活
             默认安全过滤链，导致所有接口返回 401 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- AOP：AutoFillAspect 用到 @Aspect（Boot 4 里 starter 名为 spring-boot-starter-aspectj） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- ordpf-common 是库模块，没有主类，跳过 spring-boot repackage -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>